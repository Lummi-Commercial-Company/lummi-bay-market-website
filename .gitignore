# Build-time cache: webfonts fetched by scripts/make-spec-pdf.cjs
.cache/

# ---- Next.js / Node ----
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo

# ---- TinaCMS generated client (regenerated by `tinacms build`) ----
# The trailing `*` matters: git will not descend into an excluded *directory*,
# so `tina/__generated__/` would make the three `!` lines below do nothing.
tina/__generated__/*
!tina/__generated__/_graphql.json
!tina/__generated__/_schema.json
!tina/__generated__/_lookup.json

# ---- Local env: TINA_TOKEN etc. never belong in the repo ----
.env
.env.local
.env*.local

# ---- Editors / OS ----
.DS_Store
*.log

# ---- TinaCMS generated admin bundle (rebuilt by `tinacms build`) ----
/public/admin/
