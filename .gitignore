# Build-time cache: webfonts fetched by scripts/make-spec-pdf.cjs
.cache/

# ---- Next.js / Node ----
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo

# ---- TinaCMS generated client (regenerated by `tinacms build`) ----
tina/__generated__/
!tina/__generated__/_graphql.json
!tina/__generated__/_schema.json
!tina/__generated__/_lookup.json

# ---- Local env: TINA_TOKEN etc. never belong in the repo ----
.env
.env.local
.env*.local

# ---- Editors / OS ----
.DS_Store
*.log
